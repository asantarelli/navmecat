<Window x:Class="NavMeCat.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False" Width="440">
    <Border Background="{StaticResource B.Surface}" CornerRadius="12" Margin="16"
            BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.25" Color="#FF1F2933"/>
        </Border.Effect>
        <StackPanel>
            <Border Background="{StaticResource B.Sidebar}" CornerRadius="12,12,0,0" Padding="20,16"
                    MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <StackPanel Margin="22,18,22,8">
                <TextBlock Text="When opening a table" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource B.TextMuted}" Margin="0,0,0,8"/>

                <Label Content="Default row limit"/>
                <TextBox x:Name="RowLimitBox" Width="120" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                <CheckBox x:Name="StructureCheck" Content="Open the Structure panel by default" Margin="0,0,0,8"/>
                <Grid Margin="22,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Default section" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SectionCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left"/>
                </Grid>

                <CheckBox x:Name="SqlCheck" Content="Open the SQL preview panel by default" Margin="0,0,0,8"/>
                <CheckBox x:Name="DetailCheck" Content="Open the Cell detail panel by default" Margin="0,0,0,14"/>

                <CheckBox x:Name="ClarionCheck" Content="Convert Clarion date/time columns by default" Margin="0,0,0,4"/>

                <TextBlock Text="Changes apply to tables opened from now on." FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource B.TextMuted}" Margin="0,10,0,0"/>
            </StackPanel>

            <Border Background="{StaticResource B.SurfaceAlt}" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="16,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Save" MinWidth="90" Style="{StaticResource AccentButton}"
                            Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
