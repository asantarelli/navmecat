<Window x:Class="NavMeCat.Views.RoutineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Routine" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource B.HeaderBar}"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <TextBlock x:Name="TitleLabel" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Text}"/>
                <Button x:Name="SaveButton" HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;"/>
                        <TextBlock Text="Save  (Ctrl+S)"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="13"
                     BorderThickness="0" Padding="8"/>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource B.Sidebar}" Padding="14,6">
            <TextBlock x:Name="Messages" Foreground="{StaticResource B.SidebarText}" FontSize="12"
                       VerticalAlignment="Center" Text="Loading…"/>
        </Border>
    </Grid>
</Window>
